# Inject secrets through the deployment environment. Never commit real keys.
LEDGER_ENABLED=false
LEDGER_PORT=51713
LEDGER_DATABASE_PATH=/var/lib/cardfi-ledger/ledger.sqlite
LEDGER_ENCRYPTION_KEY=<64 hex characters from a secure random generator>
LEDGER_DELETION_SECRET=<independent random secret, at least 32 characters>
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=<existing project public anon or publishable key>
CARD_API_ORIGIN=https://card.lengziyu.cn
